{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "mode": "full",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "group:all"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "pinDigests": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "regexManagers": [
    {
      "description": "Update go-version in GitHub Actions workflows",
      "fileMatch": [
        "^\\.github/workflows/[^/]+\\.ya?ml$"
      ],
      "matchStrings": [
        "go-version:\\s*['\"]?(?<currentValue>[0-9.]+)['\"]?"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    },
    {
      "description": "Update GO_VERSION env var in CI workflows",
      "fileMatch": [
        "^\\.github/workflows/[^/]+\\.ya?ml$"
      ],
      "matchStrings": [
        "GO_VERSION:\\s*['\"]?(?<currentValue>[0-9.]+)['\"]?"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    },
    {
      "description": "Update golang Docker image version in Dockerfiles",
      "fileMatch": [
        "Dockerfile",
        "Dockerfile\\..+",
        "^\\.devcontainer/Dockerfile"
      ],
      "matchStrings": [
        "FROM\\s+golang:(?<currentValue>[0-9.]+)(?:-[a-z]+)?"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Update pgschema version (declarative schema tool) in Dockerfiles",
      "fileMatch": [
        "Dockerfile",
        "Dockerfile\\..+",
        "^\\.devcontainer/Dockerfile"
      ],
      "matchStrings": [
        "ARG\\s+PGSCHEMA_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "pgplex/pgschema",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Update pinned golangci-lint version (Makefile + lefthook + CI must stay in lockstep)",
      "fileMatch": [
        "^Makefile$",
        "^lefthook\\.yml$",
        "^\\.github/workflows/[^/]+\\.ya?ml$"
      ],
      "matchStrings": [
        "golangci/golangci-lint/HEAD/install\\.sh \\| sh -s -- -b [^ ]+ v(?<currentValue>[0-9.]+)",
        "golangci-lint-version:\\s*v?(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Update pinned git-cliff version (release notes generator; Makefile + release.yml)",
      "fileMatch": [
        "^Makefile$",
        "^\\.github/workflows/[^/]+\\.ya?ml$"
      ],
      "matchStrings": [
        "GIT_CLIFF_VERSION \\?= v(?<currentValue>[0-9.]+)",
        "GIT_CLIFF_VERSION:\\s*v(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "orhun/git-cliff",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Pin Go to 1.26.x",
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "matchDatasources": [
        "golang-version",
        "gomod",
        "docker"
      ],
      "allowedVersions": "1.26.x",
      "groupName": "go"
    },
    {
      "description": "Group Go module dependencies",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "!go"
      ],
      "groupName": "go dependencies"
    },
    {
      "description": "Group all NPM dependencies",
      "matchManagers": [
        "npm"
      ],
      "groupName": "npm dependencies"
    },
    {
      "description": "Group Helm chart dependencies",
      "matchManagers": [
        "helmv3"
      ],
      "groupName": "helm dependencies"
    },
    {
      "description": "Automerge minor and patch updates for dev dependencies",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Hold eslint majors (v11+) until typescript-eslint supports them",
      "matchPackageNames": [
        "eslint",
        "@eslint/js"
      ],
      "major": {
        "enabled": false
      }
    },
    {
      "description": "Hold typescript v7 until typescript-eslint (peer <6.1.0) and rollup-plugin-dts support it",
      "matchPackageNames": [
        "typescript"
      ],
      "major": {
        "enabled": false
      }
    },
    {
      "description": "Allow both elasticsearch v8 and v9 as separate major versions",
      "matchPackageNames": [
        "github.com/elastic/go-elasticsearch/v8",
        "github.com/elastic/go-elasticsearch/v9"
      ],
      "separateMajorMinor": false,
      "major": {
        "enabled": false
      }
    },
    {
      "description": "Hold majors back until deliberate migrations: react-table v9 is an API rewrite of 16 admin files; h3 v2 breaks the docs stack (unstorage consumes v1); Dokka 2.3+ removed V1 mode required by the dokkaGfm docs pipeline",
      "matchPackageNames": [
        "@tanstack/react-table",
        "h3",
        "org.jetbrains.dokka"
      ],
      "major": {
        "enabled": false
      }
    },
    {
      "description": "maven-publish 0.31+ requires Dokka V2 mode, which dropped the GFM output format the sdk-kotlin docs pipeline depends on. Pin at 0.30.x until a deliberate Dokka V2 migration; enabled=false because allowedVersions pins have proven unreliable in this repo.",
      "matchPackageNames": [
        "com.vanniktech.maven.publish"
      ],
      "enabled": false
    }
  ]
}
