{
  "name": "@nimbleflux/fluxbase-sdk-vue",
  "version": "2026.10.2",
  "description": "Vue/Nuxt composables and SSR cookie storage for Fluxbase SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs": "typedoc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "fluxbase",
    "vue",
    "nuxt",
    "ssr",
    "database",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nimbleflux/fluxbase"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nimbleflux/fluxbase-sdk": "^2026.10.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nimbleflux/fluxbase-sdk": "workspace:*",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
