{
  "name": "@nimbleflux/fluxbase-sdk-react",
  "version": "2026.10.2",
  "description": "React hooks for Fluxbase SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "fluxbase",
    "react",
    "hooks",
    "database",
    "realtime"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nimbleflux/fluxbase"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nimbleflux/fluxbase-sdk": "^2026.10.2",
    "@tanstack/react-query": "^5.106.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nimbleflux/fluxbase-sdk": "workspace:*",
    "@tanstack/react-query": "^5.106.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
